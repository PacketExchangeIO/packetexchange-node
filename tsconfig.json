{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The SDK runs anywhere with a global `fetch` (Node 18+, Deno, Bun, browsers).
    // The DOM lib provides the `fetch`, `Request`, `Response` and `Headers` types.
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "declaration": true,
    "noEmit": true
  },
  "include": ["src"]
}
